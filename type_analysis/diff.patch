+
+        lines[type] = [[minTime-endBuff, 0]];
+        let sizeSum = 0;
+        for (let event of events[type]) {
+            if (event[2]) {
+                lines[type].push([event[0], sizeSum]);
+                sizeSum += event[1];
+                lines[type].push([event[0], sizeSum]);
+            }
+            else {
+                lines[type].push([event[0], sizeSum]);
+                sizeSum -= event[1];
+                lines[type].push([event[0], sizeSum]);
+            }
+        }
+        lines[type].push([maxTime+endBuff, sizeSum]);
+
+        d3.select("#graphLayout")
