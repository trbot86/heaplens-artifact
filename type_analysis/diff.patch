+            .datum(lines[type])
+            .attr("class", "line")
+            .attr("fill", "none")
+            .attr("stroke", colour_of_type[type])
+            .attr("stroke-width", 2)
+            .attr("transform", `translate(${LAYOUT_TRANSLATE_X}, ${LAYOUT_TRANSLATE_Y})`)
+            .attr("d", d3.line()
+                        .x(d => xScale(d[0]))
+                        .y(d => yScale(d[1]))
+            );
+    }
+
+    // Return timestamp corresponding to initial tab position
+    return getCurrTime();
+}
