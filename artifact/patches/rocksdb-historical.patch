diff --git a/Makefile b/Makefile
index 317b967ca..4c6486b0e 100644
--- a/Makefile
+++ b/Makefile
@@ -13,6 +13,91 @@ include common.mk
 CLEAN_FILES = # deliberately empty, so we can append below.
 CFLAGS += ${EXTRA_CFLAGS}
 CXXFLAGS += ${EXTRA_CXXFLAGS}
+
+ifdef REORDER_FIELDS
+$(info Reordering fields in SkipList object to shrink from 56B to 48B)
+CFLAGS += -DREORDER_FIELDS
+CXXFLAGS += -DREORDER_FIELDS
+endif
+
+ifdef CACHELINE_ALIGN_BUCKET
+$(info Aligning SkipList objects to cache line boundary)
+CFLAGS += -DCACHELINE_ALIGN_BUCKET
+CXXFLAGS += -DCACHELINE_ALIGN_BUCKET
+endif
+
+ifdef ALIGN_BUCKET
+$(info Aligning SkipList objects to $(ALIGN_BUCKET)B boundary)
+CFLAGS += -DALIGN_BUCKET=$(ALIGN_BUCKET)
+CXXFLAGS += -DALIGN_BUCKET=$(ALIGN_BUCKET)
+endif
+
+ifdef NO_PADDING_NODE
+$(info Removing all padding from Nodes, Node pointers, and SkipList objects)
+CFLAGS += -DNO_PADDING_NODE
+CXXFLAGS += -DNO_PADDING_NODE
+endif
+
+ifdef PAD_BUCKET
+$(info Padding SkipList objects to 128B)
+CFLAGS += -DPAD_BUCKET
+CXXFLAGS += -DPAD_BUCKET
+endif
+
+ifdef PAD_KEYHANDLE 
+$(info Padding KeyHandles to $(PAD_KEYHANDLE)B)
+CFLAGS += -DPAD_KEYHANDLE=$(PAD_KEYHANDLE)
+CXXFLAGS += -DPAD_KEYHANDLE=$(PAD_KEYHANDLE)
+endif
+
+ifdef ALIGN_MEMBLOCK 
+$(info Aligning memblocks to $(ALIGN_MEMBLOCK)B)
+CFLAGS += -DALIGN_MEMBLOCK=$(ALIGN_MEMBLOCK)
+CXXFLAGS += -DALIGN_MEMBLOCK=$(ALIGN_MEMBLOCK)
+endif
+
+ifdef SKIPLIST_NO_CACHELINE_CROSS
+$(info No crossing cachelines for SkipList objects - also enabling REORDER_FIELDS and CACHELINE_ALIGN_BUCKET)	
+CFLAGS += -DSKIPLIST_NO_CACHELINE_CROSS -DREORDER_FIELDS -DCACHELINE_ALIGN_BUCKET
+CXXFLAGS += -DSKIPLIST_NO_CACHELINE_CROSS -DREORDER_FIELDS -DCACHELINE_ALIGN_BUCKET
+endif
+
+ifdef ALIGN_TALL_NODE
+$(info Aligning nodes above $(ALIGN_TALL_NODE) height to cacheline boundary)
+CFLAGS += -DALIGN_TALL_NODE=$(ALIGN_TALL_NODE)
+CXXFLAGS += -DALIGN_TALL_NODE=$(ALIGN_TALL_NODE)
+endif
+
+ifdef SEG_TALL_NODE
+$(info Separating nodes above $(SEG_TALL_NODE) height to exclusive region)
+CFLAGS += -DSEG_TALL_NODE=$(SEG_TALL_NODE)
+CXXFLAGS += -DSEG_TALL_NODE=$(SEG_TALL_NODE)
+endif
+
+ifdef ALIGN_THREADDATA
+$(info Aligning ThreadData objects to cacheline boundary)	
+CFLAGS += -DALIGN_THREADDATA
+CXXFLAGS += -DALIGN_THREADDATA
+endif
+
+ifdef PREFETCH_SKIPLIST_NODE
+$(info Prefetching first layer of tall nodes)
+CFLAGS += -DPREFETCH_SKIPLIST_NODE
+CXXFLAGS += -DPREFETCH_SKIPLIST_NODE
+endif
+
+ifdef PREFETCH_NO_CHECK
+$(info Prefetching with no height check)
+CFLAGS += -DPREFETCH_NO_CHECK
+CXXFLAGS += -DPREFETCH_NO_CHECK
+endif
+
+ifdef PREFETCH_ALL
+$(info Prefetching all layers of tall nodes)
+CFLAGS += -DPREFETCH_ALL
+CXXFLAGS += -DPREFETCH_ALL
+endif
+
 LDFLAGS += $(EXTRA_LDFLAGS)
 MACHINE ?= $(shell uname -m)
 ARFLAGS = ${EXTRA_ARFLAGS} rs
