--- a/src/rax_malloc.h
+++ b/src/rax_malloc.h
@@ -38,8 +38,34 @@
 #ifndef RAX_ALLOC_H
 #define RAX_ALLOC_H
 #include "zmalloc.h"
-#define rax_malloc zmalloc
-#define rax_realloc zrealloc
+
+#include <string.h>
+
+#define RAX_SEGREGATED_MAX_SIZE 64
+
+static inline void *rax_segregated_malloc(size_t size) {
+    if (size <= RAX_SEGREGATED_MAX_SIZE) return zmalloc_cache_aligned(size);
+    return zmalloc(size);
+}
+
+static inline void *rax_segregated_realloc(void *ptr, size_t size) {
+    if (ptr == NULL) return rax_segregated_malloc(size);
+    if (size == 0) {
+        zfree(ptr);
+        return NULL;
+    }
+    if (size <= RAX_SEGREGATED_MAX_SIZE) {
+        size_t oldsize = zmalloc_size(ptr);
+        void *newptr = zmalloc_cache_aligned(size);
+        memcpy(newptr, ptr, oldsize < size ? oldsize : size);
+        zfree(ptr);
+        return newptr;
+    }
+    return zrealloc(ptr, size);
+}
+
+#define rax_malloc rax_segregated_malloc
+#define rax_realloc rax_segregated_realloc
 #define rax_free zfree
 #define rax_ptr_alloc_size zmalloc_size
 #endif
