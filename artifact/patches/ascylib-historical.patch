diff --git a/common/Makefile.common b/common/Makefile.common
index 7306db9..b13fe73 100644
--- a/common/Makefile.common
+++ b/common/Makefile.common
@@ -260,6 +260,32 @@ CFLAGS += -I$(LIBAO_INC) -I$(ROOT)/include -I$(LIBSSMEM)/include
 
 LDFLAGS += -lpthread -lrt -lm
 
+ifdef USE_MEMHOOK
+    CFLAGS += -I/root/sifter/memhook/ -DMEMHOOK_ASCYLIB
+    LDFLAGS += -L/root/sifter/memhook/ -Wl,-rpath=/root/sifter/memhook/ -lmemhook -ldl
+endif
+
+ifdef SEG_OBJS
+    CFLAGS += -DSEG_OBJS
+endif
+
+ifdef FORCE_MALLOC
+    CFLAGS += -DFORCE_MALLOC
+    LDFLAGS += -L../jemalloc/lib/ -Wl,-rpath=../jemalloc/lib/
+endif
+
+ifeq ($(FORCE_MALLOC),jemalloc)
+    LDFLAGS += -ljemalloc
+endif
+
+ifeq ($(FORCE_MALLOC),mimalloc)
+    LDFLAGS += -lmimalloc
+endif
+
+ifdef DRACHSLER_PAD
+    CFLAGS += -DDRACHSLER_PAD=$(DRACHSLER_PAD)
+endif
+
 ######################
 # compilation settings
 ######################
@@ -325,6 +351,14 @@ else
 	CFLAGS += -DINITIALIZE_FROM_ONE=1
 endif
 
+ifeq ($(BAD_FIELDS),1)
+    CFLAGS += -DBAD_FIELDS
+endif
+
+ifeq ($(BRONSON_NO_PAD),1)
+    CFLAGS += -DBRONSON_NO_PAD
+endif
+
 ifeq ($(SET_CPU),0)
 	CFLAGS += -DNO_SET_CPU
 endif
